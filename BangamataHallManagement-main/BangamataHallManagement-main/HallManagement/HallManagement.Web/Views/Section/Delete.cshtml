@model HallManagement.Model.Entities.Section

@{
    ViewData["Title"] = "Delete";
}

<div class="container">
    <h4 class="pb-2 pt-2 border-bottom border-2 border-dark">Section Delete</h4>

    <h3>Are you sure you want to delete this 'Section'?</h3>
    <div>
        <div class="row">
            <div class="offset-md-2 col-md-6">
                <div class="form-group row">
                    <label asp-for="Name" class="col-md-5 col-form-label text-md-end fw-bold pt-4"></label>
                    <div class="col-md-7 pt-md-3">
                        <input asp-for="Name" placeholder="Please type here" required="true" class="form-control" disabled="disabled" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="offset-md-5 col-md-7 pt-3">
                        <form asp-action="Delete">
                            <input type="hidden" asp-for="Id" />
                            <input type="submit" value="Delete" class="btn btn-danger" /> |
                            <a asp-action="Index">Back to List</a>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>