                        <input asp-for="Name" placeholder="@Model.Name" class="form-control" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="FatherName" class="col-md-6 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
