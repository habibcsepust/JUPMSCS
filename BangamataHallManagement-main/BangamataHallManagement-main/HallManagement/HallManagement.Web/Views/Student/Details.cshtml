                    <div class="col-md-5">
                        <input asp-for="ReligionName" class="form-control form-select" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="NationalityName" class="col-md-3 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
