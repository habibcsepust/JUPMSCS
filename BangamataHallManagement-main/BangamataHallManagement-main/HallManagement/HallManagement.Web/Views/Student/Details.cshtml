                </div>
                <div class="form-group row pt-2">
                    <label asp-for="DepartmentName" class="col-md-6 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="DepartmentName" class="form-control form-select" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
