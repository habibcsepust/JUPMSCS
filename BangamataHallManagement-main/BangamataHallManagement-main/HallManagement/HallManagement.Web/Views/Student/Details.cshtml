@model HallManagement.Model.ViewModels.StudentDetailVm

@{
    ViewData["Title"] = "Student Details";
}
<div class="container">
    <h4>Student Details</h4>
    <hr />
    <form class="form-horizontal">
        @*     @Html.ValidationSummary()*@
        <div asp-validation-summary="ModelOnly" class="text-center text-danger"></div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group row pt-2">
                    <label asp-for="NameInEnglish" class="col-md-6 col-form-label text-md-end fw-bold"></label>
