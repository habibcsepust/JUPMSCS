                    <div class="col-md-5">
                        <input asp-for="SectionName" class="form-control form-select" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="EntryBy" class="col-md-6 col-form-label text-md-end fw-bold"></label>
