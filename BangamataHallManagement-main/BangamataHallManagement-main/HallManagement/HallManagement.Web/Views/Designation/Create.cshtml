@model HallManagement.Model.Entities.Designation

@{
    ViewData["Title"] = "Create";
}

<div class="container">
    <h4 class="pb-2 pt-2 border-bottom border-2 border-dark">Designation Entry</h4>
    <form asp-action="Create" id="myForm" class="form-horizontal">
        @*     @Html.ValidationSummary()*@
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row">
            <div class="offset-md-2 col-md-6">
                <div class="form-group row">
                    <label asp-for="Name" class="col-md-5 col-form-label text-md-end fw-bold pt-4"></label>
                    <div class="col-md-7 pt-md-3">
                        <input asp-for="Name" placeholder="Please type here" required="true" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="offset-md-5 col-md-3 pt-3">
                        <input type="submit" value="Create" class="col-md-12 btn btn-primary" />
                    </div>
                    <div class="col-md-4 pt-4">
                        <a asp-action="Index">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
