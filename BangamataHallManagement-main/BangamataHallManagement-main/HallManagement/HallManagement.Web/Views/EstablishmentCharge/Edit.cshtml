@model HallManagement.Model.ViewModels.EstablishmentChargeVm

@{
    ViewData["Title"] = "Update Establishment Charge";
}

<div class="container">
    <h4>Establishment Charge Update</h4>
    <hr />
    <form asp-action="Edit" id="myForm" class="form-horizontal">
        @*     @Html.ValidationSummary()*@
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group row pt-2">
                    <label asp-for="StudentId" class="fw-bold col-md-6 col-form-label text-md-end"></label>
                    <div class="col-md-5">
                        <select asp-for="StudentId" class="form-control form-select" asp-items="Model.StudentList">
                            <option value="">--Select--</option>
                        </select>
                        <span asp-validation-for="StudentId" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="Year" class="fw-bold col-md-6 col-form-label text-md-end"></label>
                    <div class="col-md-5">
                        <input asp-for="Year" class="form-control" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="PaidAmount" class="fw-bold col-md-6 col-form-label text-md-end"></label>
                    <div class="col-md-5">
                        <input asp-for="PaidAmount" class="form-control" />
                        <span asp-validation-for="PaidAmount" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
            </div>
            <div class="offset-md-3 col-md-6">
                <div class="row">
                    <div class="col-sm-5 col-md-5 mt-4">
                        <input type="submit" value="Create" class="col-md-12 btn btn-success" />
                    </div>
                    <div class="col-sm-5 col-md-2 mt-4">
                        <a asp-action="Index" class="pt-2 link-primary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row pt-3">
        </div>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            alert(1)
            document.querySelector('#resetBtn').addEventListener('click', function (event) {
                event.preventDefault(); // Prevents the default reset behavior
                alert(2)
                document.getElementById('myForm').reset();
                // Additional client-side operations upon reset if needed
            });
        }
    </script>
}
