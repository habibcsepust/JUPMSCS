@using HallManagement.Model.ViewModels;
@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Web</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <!-- link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" -->
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <!--script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></!--script-->
    <script src="~/lib/bootstrap/dist/css/bootstrap.bundle.js"></script>
</head>
<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/dashboard/index"><img height="35" style="margin:0; padding:0 15px 0 0" width="80" src="~/images/logo.png" /><b class="mt-3">Bangamata Hall</b></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                @{
                    if (!string.IsNullOrEmpty(Context.Session.GetString("Name")))
                    {
                        var menuAccessJson = Context.Session.GetString("MenuAccess");
                        if (!string.IsNullOrEmpty(menuAccessJson))
                        {
                            var menuAccess = Newtonsoft.Json.JsonConvert.DeserializeObject<List<MenuVm>>(menuAccessJson);
                            <ul class="navbar-nav ms-auto">
                                @foreach (MenuVm menu in menuAccess)
                                {
                                    if (menu.SubMenus.Count == 0)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link" href="@menu.Url">@menu.Name</a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle" href="#" id="servicesDropdown" role="button"
                                               data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                @menu.Name
                                            </a>
                                            <div class="dropdown-menu" aria-labelledby="servicesDropdown">
                                                @foreach (MenuVm subMenu in menu.SubMenus)
                                                {
                                                    <a class="dropdown-item" href="@subMenu.Url">@subMenu.Name</a>
                                                }
                                            </div>
                                        </li>
                                    }
                                }
                            </ul>
                        }
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="#">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">About</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="servicesDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Services
                                </a>
                                <div class="dropdown-menu" aria-labelledby="servicesDropdown">
                                    <a class="dropdown-item" href="#">Service1</a>
                                    <a class="dropdown-item" href="#">Service2</a>
                                    <a class="dropdown-item" href="#">Service3</a>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">Contact</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Login">Login</a>
                            </li>
                        </ul>
                    }
                }
            </div>
        </div>
    </nav>

    <main class="container-fluid pe-0 ps-0" style="padding-top:62px;">
        @{
            if (!string.IsNullOrEmpty(Context.Session.GetString("Name")))
            {
                <div class="bg-light text-end" style="padding-bottom:2px;">
                    <div class="container">
                        <b class="text-end text-warning pe-2">Welcome! @Context.Session.GetString("Name") | <a class="text-underline text-danger" style="text-decoration:underline" href="/Account/Logout/">Logout</a></b>
                    </div>
                </div>
            }
        }
        @RenderBody()
        <!-- Add your content here -->
    </main>

    @await RenderSectionAsync("Scripts", required: false)

    <footer>
        <div class="container pt-2">
            <p>&copy; @DateTime.Now.Year Bangamata Hall. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>