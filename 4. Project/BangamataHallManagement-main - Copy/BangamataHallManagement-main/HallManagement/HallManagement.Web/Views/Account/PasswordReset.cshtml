@using HallManagement.Model.ViewModels;
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}
<div class="container">
    <div class="row">
        <div class="col-md-4 offset-md-4">
            <div class="card my-5">

                <form asp-controller="Account" asp-action="ResetPassword" method="post" class="card-body cardbody-color p-lg-5">
                    <div class="text-center">
                        <i class="fas fa-lock fa-5x"></i>
                    </div>
                    <div class="text-center">
                        <h3 class="text-center text-dark mt-3">Reset Password</h3>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="IsStudentLogin" />
                    </div>

                    <div class="mb-3">
                        <div class="input-group mt-3">
                            <span class="input-group-text bg-dark-subtle" id="basic-addon1">New Password</span>
                            <input type="password" class="form-control" asp-for="NewPassword" aria-describedby="emailHelp" placeholder="Type new password" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="input-group mt-3">
                            <span class="input-group-text bg-dark-subtle" id="basic-addon1">Confirm Password</span>
                            <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Re-type password" />
                        </div>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-success px-5 mb-3  w-100">Reset Password</button>
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>