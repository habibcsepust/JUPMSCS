@using HallManagement.Model.ViewModels;
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
<div class="container">
    <div class="row">
        <div class="col-md-4 offset-md-4">
            <div class="card my-5 m-4 p-4">
                <div class="panel-body">
                    <div class="text-center">
                        <form method="post" action="ForgotPassword">
                            <div class="form-group">
                                <h3><i class="fa fa-user-lock fa-3x"></i></h3>
                                <div asp-validation-summary="All" class="text-danger"></div>
                                <h4>Forgot Password?</h4>
                                <p>You can reset your password here.</p>

                                <div class="form-group">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <b>User Type</b>
                                        </div>
                                        <div class="col-md-4">
                                            @Html.RadioButtonFor(e => e.IsStudentLogin, false, new { id = "false" }) @Html.Label("false", "Staff")
                                        </div>
                                        <div class="col-md-4">
                                            @Html.RadioButtonFor(e => e.IsStudentLogin, true, new { id = "true" }) @Html.Label("true", "Student")
                                        </div>
                                    </div>
                                </div>
                                <div class="input-group mt-3">
                                    <span class="input-group-text bg-dark-subtle" id="basic-addon1">Login ID</span>
                                    <input asp-for="Mobile" placeholder="Type mobile number here" class="form-control" />
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-danger col-md-12 mt-3">Get Password Reset Link</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>