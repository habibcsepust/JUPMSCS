                        <input asp-for="Email" class="form-control" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="ActingDateFrom" class="col-md-6 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="ActingDateFrom" type="date" class="form-control" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="ActingDateTo" class="col-md-6 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="ActingDateTo" type="date" class="form-control" disabled="disabled" />
