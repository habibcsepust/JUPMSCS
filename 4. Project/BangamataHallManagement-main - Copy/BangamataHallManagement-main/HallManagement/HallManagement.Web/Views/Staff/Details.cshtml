@model HallManagement.Model.ViewModels.StaffDetailVm

@{
    ViewData["Title"] = "Staff Details";
}

<div class="container">
    <h4>Staff Details</h4>
    <hr />
    <form asp-action="" class="form-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group row pt-2">
                    <label asp-for="Name" class="col-md-6 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="Name" class="form-control" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="DesignationName" class="col-md-6 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="DesignationName" class="form-control form-select" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="DepartmentName" class="col-md-6 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="DepartmentName" class="form-control form-select" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
