                    <div class="col-md-5">
                        <input asp-for="DisplayOrder" class="form-control" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="IsActive" class="col-md-3 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="IsActive" class="form-control" disabled="disabled" />
                    </div>
                </div>
            </div>
            <div class="offset-md-3 col-md-6">
                <div class="row">
                    <div class="col-sm-5 col-md-2 mt-4">
                        <a asp-action="Index" class="pt-2 link-primary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row pt-3">
        </div>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            alert(1)
            document.querySelector('#resetBtn').addEventListener('click', function (event) {
                event.preventDefault(); // Prevents the default reset behavior
                alert(2)
                document.getElementById('myForm').reset();
                // Additional client-side operations upon reset if needed
            });
        }
    </script>
}
