                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group row pt-2">
                    <label asp-for="EntryBy" class="col-md-3 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="EntryBy" class="form-control" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="EntryDate" class="col-md-3 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="EntryDate" class="form-control" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="ModifyBy" class="col-md-3 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="ModifyBy" class="form-control" disabled="disabled" />
                    </div>
                </div>
                <div class="form-group row pt-2">
                    <label asp-for="ModifyDate" class="col-md-3 col-form-label text-md-end fw-bold"></label>
                    <div class="col-md-5">
                        <input asp-for="ModifyDate" class="form-control" disabled="disabled" />
