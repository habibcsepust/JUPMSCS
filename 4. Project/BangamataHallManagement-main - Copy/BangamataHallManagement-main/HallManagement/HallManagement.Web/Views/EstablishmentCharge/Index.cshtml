@{
    ViewData["Title"] = "Index";
}
<div class="container">
    <h4 class="pb-2 pt-2 border-bottom border-2 border-dark">Establishment Charge List</h4>

    <p>
        <a asp-action="Create">Create New Establishment Charge</a>
    </p>

    <div class="col-md-12" style="overflow-x:scroll;overflow:auto;">
        <table class="table table-hover table-striped table-responsive caption-top">
            <caption class="bg-primary text-center text-white">
                Establishment Charge List:
            </caption>
            <thead class="table-primary text-white">
            <th>Student Name.</th>
            <th>Class Roll No.</th>
            <th>Department</th>
            <th>Charge Year</th>
            <th>Paid Amount(Tk.)</th>
            <th>Action</th>
            </thead>
            <tbody id="pagedData">
            </tbody>
        </table>
    </div>
    <div class="col-md-12" style="overflow-x:scroll;overflow:auto;">
        <div id="pagingButtons"></div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            var pageSize = 10; // Change it to your desired page size
            var pageNumber = 1; // Initially load the first page
            fetchData(pageNumber, pageSize);

            function fetchData(pageNumber, pageSize) {
                $.ajax({
                    url: '@Url.Action("GetPagedData", "EstablishmentCharge")',
                    type: 'GET',
                    dataType: 'json',
                    data: { pageNumber: pageNumber, pageSize: pageSize },
                    success: function (response) {
                        console.log(response)
                        displayData(response.data);
                        displayPagination(response.totalRecords, pageNumber, pageSize);
                    },
                    error: function (ex) {
                        console.error('Error fetching data.' + ex);
                    }
                });
            }

            function displayData(data) {
                var html = '';
                $.each(data, function (index, item) {
                    html += '<tr>';
                    html += '<td>' + (item.StudentName !== null ? item.StudentName : "") + '</td>';
                    html += '<td>' + (item.ClassRollNo !== null ? item.ClassRollNo : "") + '</td>';
                    html += '<td>' + (item.DepartmentName !== null ? item.DepartmentName : "") + '</td>';
                    html += '<td>' + (item.ChargeYear !== null ? item.ChargeYear : "") + '</td>';
                    html += '<td>' + (item.PaidAmount !== null ? item.PaidAmount : "") + '</td>';
                    html += '<td><a href="/EstablishmentCharge/Edit?id=' + item.Id + '">Edit</a> | <a href="/EstablishmentCharge/Details?id=' + item.Id + '">Details</a></td>';
                    html += '</tr>';
                });
                html += '';
                $('#pagedData').html(html);
            }

            function displayPagination(totalRecords, pageNumber, pageSize) {
                var totalPages = Math.ceil(totalRecords / pageSize);
                var paginationHtml = '<ul class="pagination">';

                // First button
                paginationHtml += '<li class="page-item ' + (pageNumber === 1 ? 'disabled' : '') + '">';
                paginationHtml += '<a class="page-link" href="#" data-page="1">First</a>';
                paginationHtml += '</li>';

                // Previous button
                paginationHtml += '<li class="page-item ' + (pageNumber === 1 ? 'disabled' : '') + '">';
                paginationHtml += '<a class="page-link" href="#" data-page="' + (pageNumber - 1) + '">Previous</a>';
                paginationHtml += '</li>';

                // Page buttons
                var startPage = Math.max(1, pageNumber - 4);
                var endPage = Math.min(totalPages, startPage + 9);
                for (var i = startPage; i <= endPage; i++) {
                    paginationHtml += '<li class="page-item ' + (pageNumber === i ? 'active' : '') + '">';
                    paginationHtml += '<a class="page-link" href="#" data-page="' + i + '">' + i + '</a>';
                    paginationHtml += '</li>';
                }

                // Next button
                paginationHtml += '<li class="page-item ' + (pageNumber === totalPages ? 'disabled' : '') + '">';
                paginationHtml += '<a class="page-link" href="#" data-page="' + (pageNumber + 1) + '">Next</a>';
                paginationHtml += '</li>';

                // Last button
                paginationHtml += '<li class="page-item ' + (pageNumber === totalPages ? 'disabled' : '') + '">';
                paginationHtml += '<a class="page-link" href="#" data-page="' + totalPages + '">Last</a>';
                paginationHtml += '</li>';

                paginationHtml += '</ul>';

                $('#pagingButtons').html(paginationHtml);
            }

            $(document).on('click', '.pagination a', function (e) {
                e.preventDefault();
                pageNumber = $(this).data('page');
                fetchData(pageNumber, pageSize);
            });
        });
    </script>
}     