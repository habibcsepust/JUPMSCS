@{
    ViewData["Title"] = "Home Page";
}

<style>
    /* Hero Carousel Styles */
    .carousel-item img {
        height: 70vh;
        object-fit: cover;
        filter: brightness(0.45);
    }

    .carousel-caption {
        bottom: 30%;
        z-index: 10;
    }

        .carousel-caption h5 {
            font-size: 3.5rem;
            font-weight: 700;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.5);
        }

        .carousel-caption p {
            font-size: 1.2rem;
            font-weight: 300;
        }

    /* Modern Cards */
    .premium-card {
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .premium-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        }

    .feature-icon-box {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px auto;
        transition: all 0.3s ease;
    }

    .premium-card:hover .feature-icon-box {
        transform: scale(1.1);
    }

    /* Section Titles */
    .section-title {
        font-weight: 700;
        color: #0a2540;
        position: relative;
        display: inline-block;
        margin-bottom: 2rem;
    }

        .section-title::after {
            content: "";
            position: absolute;
            width: 50%;
            height: 3px;
            background: #007bff;
            bottom: -10px;
            left: 25%;
            border-radius: 5px;
        }

    /* Custom Accordion */
    .accordion-button:not(.collapsed) {
        background-color: #f0f7ff;
        color: #0a2540;
        font-weight: 600;
    }

    .accordion-button:focus {
        box-shadow: none;
    }

    .check-list li {
        margin-bottom: 12px;
        color: #495057;
    }
</style>

<!-- Hero Slider -->
<div id="imageSlider" class="carousel slide carousel-fade" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/slider-images/1.jpg" class="d-block w-100" alt="Smart Campus" />
            <div class="carousel-caption d-none d-md-block text-center">
                <h5>Welcome to Smart Hall Management</h5>
                <p>Ensuring a secure, automated, and comfortable residential experience.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/slider-images/5.jpg" class="d-block w-100" alt="Modern Administration" />
            <div class="carousel-caption d-none d-md-block">
                <h5>Modern Administration</h5>
                <p>Digitalizing administrative services for students and staff.</p>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#imageSlider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#imageSlider" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!-- Welcome Message -->
<div class="container mt-n5 position-relative" style="z-index: 20;">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card premium-card p-4 text-center">
                <div class="card-body">
                    <h2 class="section-title">University Hall Management System</h2>
                    <p class="text-muted fs-5 mt-3">A comprehensive, automated, and highly secure digital platform designed to streamline campus residential workflows worldwide.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Core Features Section -->
<div class="container py-5 mt-4">
    <div class="row g-5 align-items-center">
        <!-- Feature Grid (2x2) -->
        <div class="col-lg-7">
            <div class="row g-4">

                <!-- Feature 1: Seat Allocation -->
                <div class="col-sm-6">
                    <div class="premium-card p-4 text-center h-100 border-top border-4 border-primary">
                        <div class="feature-icon-box" style="background: rgba(0, 123, 255, 0.1);">
                            <i class="fas fa-bed fa-2x text-primary"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Smart Seat Allocation</h5>
                        <p class="text-muted small mb-0">Precise room tracking with specific direction (North, South, East, West) assignments.</p>
                    </div>
                </div>

                <!-- Feature 2: Meal Management -->
                <div class="col-sm-6">
                    <div class="premium-card p-4 text-center h-100 border-top border-4 border-success">
                        <div class="feature-icon-box" style="background: rgba(40, 167, 69, 0.1);">
                            <i class="fas fa-utensils fa-2x text-success"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Meal Management</h5>
                        <p class="text-muted small mb-0">Seamlessly manage and track daily dining schedules for Breakfast, Lunch & Dinner.</p>
                    </div>
                </div>

                <!-- Feature 3: Late Entry Pass -->
                <div class="col-sm-6">
                    <div class="premium-card p-4 text-center h-100 border-top border-4 border-warning">
                        <div class="feature-icon-box" style="background: rgba(255, 193, 7, 0.1);">
                            <i class="fas fa-door-open fa-2x text-warning"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Late Entry Pass</h5>
                        <p class="text-muted small mb-0">Quick digital applications for late arrivals, monitored by admins before curfew.</p>
                    </div>
                </div>

                <!-- Feature 4: Digital Billing -->
                <div class="col-sm-6">
                    <div class="premium-card p-4 text-center h-100 border-top border-4 border-info">
                        <div class="feature-icon-box" style="background: rgba(23, 162, 184, 0.1);">
                            <i class="fas fa-file-invoice-dollar fa-2x text-info"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Digital Billing</h5>
                        <p class="text-muted small mb-0">Automated establishment charges and secure payment history tracking.</p>
                    </div>
                </div>

            </div>
        </div>

        <!-- System Details Text -->
        <div class="col-lg-5">
            <div class="p-3 ps-lg-4">
                <h3 class="fw-bold text-dark mb-4">Modernizing Campus Residence</h3>
                <p class="text-muted" style="text-align: justify; line-height: 1.8; font-size: 1.05rem;">
                    This Hall Management System is an enterprise-grade solution designed to bridge the gap between students and the hall administration. It transforms traditional, paper-based administrative tasks into a fast, transparent, and highly efficient digital ecosystem.
                </p>
                <ul class="list-unstyled mt-4 check-list font-weight-bold">
                    <li><i class="fas fa-check-circle text-primary me-3 fs-5 align-middle"></i> Direction-wise specific seat mapping</li>
                    <li><i class="fas fa-check-circle text-primary me-3 fs-5 align-middle"></i> Integrated 3-time daily meal tracking</li>
                    <li><i class="fas fa-check-circle text-primary me-3 fs-5 align-middle"></i> Pre-curfew digital passes for late entry</li>
                </ul>
                <a href="/Home/About" class="btn btn-primary rounded-pill px-4 py-2 mt-3 shadow-sm">
                    Learn More <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- FAQ Section -->
<div class="container py-5 mb-5 bg-light rounded-3">
    <div class="text-center mb-5">
        <h3 class="section-title">Frequently Asked Questions</h3>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="accordion premium-card" id="faqAccordion">
                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            How does the Late Entry Pass work?
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            If you expect to arrive after the standard curfew (e.g., 11:00 PM), you can submit a quick 'Late Entry Request' via your student portal before the gate closes. Admins review this list to allow seamless late entry.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingTwo">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                            How to apply for a specific hall seat?
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Our system maps each room into specific directions (North, South, East, West). When applying, seats are allocated based on exact positioning to ensure maximum comfort and transparent distribution.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0">
                    <h2 class="accordion-header" id="headingThree">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                            Can I manage my meals online?
                        </button>
                    </h2>
                    <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Yes! The Meal Management module allows you to track and manage your dining schedules for Breakfast, Lunch, and Dinner directly from your dashboard.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>