@{
    ViewData["Title"] = "About Project";
}

<style>
    .about-header {
        background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%); /* Premium dark corporate gradient */
        color: white;
        padding: 70px 0;
        border-radius: 24px;
        margin-bottom: 40px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

        .about-header::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%;
        }

    .developer-card {
        border: none;
        border-top: 5px solid #203a43;
        border-radius: 20px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        background: #ffffff;
    }

        .developer-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
        }

    .tech-badge {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        color: #495057;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
        margin: 4px;
        display: inline-block;
        transition: all 0.2s ease;
    }

        .tech-badge:hover {
            background: #e9ecef;
            transform: translateY(-2px);
        }
</style>

<div class="container py-5 mt-3">
    <!-- Header Banner -->
    <div class="about-header text-center">
        <i class="fas fa-layer-group fa-4x mb-4 shadow-sm rounded-circle p-4 bg-white text-dark" style="color: #203a43 !important;"></i>
        <h1 class="fw-bold mt-2" style="letter-spacing: -0.5px;">Smart Hall Management System</h1>
        <p class="lead text-white-50 mt-3 fw-light">A Universal Digital Ecosystem for Campus Residential Services</p>
    </div>

    <div class="row g-4 align-items-stretch">
        <!-- Project Details -->
        <div class="col-md-7 col-lg-8">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 20px;">
                <div class="card-body p-4 p-md-5 text-muted" style="text-align: justify; line-height: 1.9;">
                    <h4 class="fw-bold text-dark mb-4"><i class="fas fa-info-circle me-2" style="color: #203a43;"></i> Project Overview</h4>
                    <p class="fs-6 text-dark mb-4">
                        This enterprise-grade application is developed to modernize and automate the complex administrative workflows of university residential halls worldwide. It eliminates paper-based redundancies and introduces a transparent, real-time digital infrastructure.
                    </p>
                    <p>
                        The core architecture focuses on scalability and user experience, seamlessly integrating modules like <strong>Smart Seat Allocation</strong> (with directional mapping), <strong>Dynamic Meal Management</strong>, <strong>Late Entry Digital Passes</strong>, and automated financial tracking. It is designed to ensure a highly secure and efficient process for both the administration and the resident students.
                    </p>

                    <hr class="my-4 opacity-25">

                    <h6 class="fw-bold text-dark mb-3">Core Technology Stack</h6>
                    <div>
                        <span class="tech-badge"><i class="fab fa-microsoft text-primary me-1"></i> ASP.NET Core</span>
                        <span class="tech-badge"><i class="fas fa-database text-secondary me-1"></i> SQL Server</span>
                        <span class="tech-badge"><i class="fab fa-bootstrap text-purple me-1" style="color: #7952b3;"></i> Bootstrap 5</span>
                        <span class="tech-badge"><i class="fas fa-shield-alt text-success me-1"></i> Role-Based Auth</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Developer Credit Card -->
        <div class="col-md-5 col-lg-4">
            <div class="card developer-card shadow-sm h-100">
                <div class="card-body p-4 p-md-5 text-center d-flex flex-column justify-content-center align-items-center">
                    <h6 class="fw-bold text-muted mb-4 text-uppercase" style="letter-spacing: 1px; font-size: 0.8rem;">System Architecture</h6>

                    <div class="mb-4 position-relative">
                        <div style="width: 100px; height: 100px; background: #f4f7f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto; box-shadow: inset 0 4px 10px rgba(0,0,0,0.05);">
                            <i class="fas fa-laptop-code fa-2x" style="color: #203a43;"></i>
                        </div>
                    </div>

                    <!-- Converted to English -->
                    <h4 class="fw-bold text-dark mb-1">Md. Habibur Rahman</h4>
                    <p class="text-muted small mb-4">Software Engineer & System Architect</p>

                    <div class="mt-auto pt-4 border-top w-100">
                        <span class="badge bg-light text-dark border px-4 py-2 rounded-pill shadow-sm fw-bold">
                            <i class="fas fa-graduation-cap me-2 text-primary"></i> Final Semester Project
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>