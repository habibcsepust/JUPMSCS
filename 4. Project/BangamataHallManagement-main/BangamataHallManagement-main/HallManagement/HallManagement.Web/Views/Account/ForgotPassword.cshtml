@using HallManagement.Model.ViewModels;
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    /* Premium Auth Page Styles (Consistent with Login) */
    .auth-wrapper {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f0f7ff 0%, #e0eafc 100%);
        padding: 2rem 0;
    }

    .premium-auth-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(10, 37, 64, 0.08);
        border: 1px solid rgba(255,255,255,0.5);
        overflow: hidden;
        animation: slideUpFade 0.6s ease-out forwards;
    }

    @@keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Icon Header */
    .icon-header-warning {
        background: linear-gradient(135deg, #0a2540 0%, #dc3545 100%); /* Red/Dark gradient for reset */
        height: 120px;
        position: relative;
        display: flex;
        justify-content: center;
    }

        .icon-header-warning i {
            font-size: 3.5rem;
            color: #dc3545;
            background: #ffffff;
            padding: 20px 22px;
            border-radius: 50%;
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
            position: absolute;
            bottom: -40px;
            border: 5px solid #fff;
        }

    /* Modern Inputs */
    .modern-input-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

        .modern-input-group i {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: 18px;
            color: #6c757d;
            z-index: 10;
        }

    .modern-input {
        height: 55px;
        border-radius: 12px;
        padding-left: 45px !important;
        border: 1px solid #dee2e6;
        background-color: #f8f9fa;
        transition: all 0.3s;
    }

        .modern-input:focus {
            background-color: #fff;
            border-color: #dc3545;
            box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.1);
        }

    /* Segmented Control for Radio Buttons */
    .user-type-selector {
        display: flex;
        gap: 15px;
        margin-bottom: 2rem;
    }

        .user-type-selector .form-check-input {
            display: none;
        }

        .user-type-selector .custom-radio-label {
            flex: 1;
            padding: 12px;
            text-align: center;
            border: 2px solid #e9ecef;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            color: #6c757d;
            transition: all 0.2s ease;
        }

        .user-type-selector .form-check-input:checked + .custom-radio-label {
            border-color: #dc3545;
            background-color: rgba(220, 53, 69, 0.05);
            color: #dc3545;
            box-shadow: 0 4px 10px rgba(220, 53, 69, 0.1);
        }

    /* Reset Button */
    .btn-reset {
        background: linear-gradient(135deg, #e83e8c 0%, #dc3545 100%);
        border: none;
        border-radius: 12px;
        height: 55px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .btn-reset:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(220, 53, 69, 0.3);
        }
</style>

<div class="auth-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card premium-auth-card">

                    <div class="icon-header-warning">
                        <i class="fas fa-unlock-alt"></i>
                    </div>

                    <form method="post" action="ForgotPassword" class="card-body px-5 pt-5 pb-4 mt-3">
                        <div class="text-center mb-4">
                            <h3 class="fw-bold text-dark mb-1">Forgot Password?</h3>
                            <p class="text-muted small">Don't worry, we'll send you reset instructions.</p>
                        </div>

                        <div asp-validation-summary="All" class="text-danger small fw-bold mb-3 text-center"></div>

                        <!-- User Type Selection (Modern Radio) -->
                        <div class="user-type-selector mt-2">
                            <div class="flex-fill">
                                @Html.RadioButtonFor(e => e.IsStudentLogin, false, new { id = "false", @class = "form-check-input" })
                                <label class="custom-radio-label w-100" for="false">
                                    <i class="fas fa-user-tie me-2"></i>Staff
                                </label>
                            </div>
                            <div class="flex-fill">
                                @Html.RadioButtonFor(e => e.IsStudentLogin, true, new { id = "true", @class = "form-check-input" })
                                <label class="custom-radio-label w-100" for="true">
                                    <i class="fas fa-user-graduate me-2"></i>Student
                                </label>
                            </div>
                        </div>

                        <!-- Login ID / Mobile Input -->
                        <div class="modern-input-group">
                            <i class="fas fa-mobile-alt"></i>
                            <input asp-for="Mobile" class="form-control modern-input" placeholder="Enter Mobile Number" autocomplete="off" />
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-danger btn-reset w-100 mb-3 text-white">
                                Get Password Reset Link <i class="fas fa-arrow-right ms-2"></i>
                            </button>
                        </div>

                        <!-- Back to Login Link -->
                        <div class="text-center mt-2">
                            <a href="/Account/Login" class="text-decoration-none fw-bold text-muted small">
                                <i class="fas fa-arrow-left me-1"></i> Back to Login
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}