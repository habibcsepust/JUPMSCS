@{
    ViewData["Title"] = "Student List";
}

<style>
    /* Premium Table Styles */
    body {
        background-color: #f4f7f6;
    }

    .table-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: none;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .table-custom {
        margin-bottom: 0;
        white-space: nowrap;
    }

        .table-custom thead th {
            background-color: #1e3c72;
            color: #ffffff;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.85rem;
            padding: 15px;
            border: none;
        }

        .table-custom tbody td {
            padding: 15px;
            vertical-align: middle;
            color: #495057;
            font-size: 0.95rem;
            border-bottom: 1px solid #f0f2f5;
            transition: background-color 0.2s ease;
        }

        .table-custom tbody tr:hover td {
            background-color: #f8faff;
        }

    /* Badges & Action Buttons */
    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .btn-action {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s;
    }

        .btn-action:hover {
            transform: translateY(-2px);
        }

    /* Custom Pagination */
    .modern-pagination .page-link {
        border: none;
        color: #495057;
        font-weight: 600;
        border-radius: 8px;
        margin: 0 4px;
        padding: 8px 16px;
        transition: all 0.3s;
    }

    .modern-pagination .page-item.active .page-link {
        background-color: #007bff;
        color: white;
        box-shadow: 0 4px 10px rgba(0, 123, 255, 0.3);
    }

    .modern-pagination .page-link:hover:not(.active) {
        background-color: #f0f7ff;
        color: #007bff;
    }
</style>

<div class="container py-4">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="fas fa-users-cog text-primary me-2"></i> Student Directory</h3>
            <p class="text-muted small mb-0 mt-1">Manage and view all registered students</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="fas fa-plus-circle me-2"></i> Add New Student
        </a>
    </div>

    <!-- Table Card -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-custom table-hover">
                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>Roll No.</th>
                        <th>Department</th>
                        <th>Program</th>
                        <th>Session</th>
                        <th>Section</th>
                        <th>Batch</th>
                        <th>Contact Info</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="pagedData">
                    <!-- Data will be loaded here via AJAX -->
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">
                            <i class="fas fa-spinner fa-spin me-2"></i> Loading data...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination Section -->
        <div class="bg-light p-3 border-top d-flex justify-content-center justify-content-md-end">
            <div id="pagingButtons" class="modern-pagination"></div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            var pageSize = 10;
            var pageNumber = 1;
            fetchData(pageNumber, pageSize);

            function fetchData(pageNumber, pageSize) {
                $.ajax({
                    url: '@Url.Action("GetPagedData", "Student")',
                    type: 'GET',
                    dataType: 'json',
                    data: { pageNumber: pageNumber, pageSize: pageSize },
                    success: function (response) {
                        displayData(response.data);
                        displayPagination(response.totalRecords, pageNumber, pageSize);
                    },
                    error: function (ex) {
                        console.error('Error fetching data.' + ex);
                        $('#pagedData').html('<tr><td colspan="10" class="text-center text-danger py-4">Failed to load data.</td></tr>');
                    }
                });
            }

            function displayData(data) {
                var html = '';

                if(data.length === 0) {
                    html = '<tr><td colspan="10" class="text-center py-4 text-muted">No students found in the system.</td></tr>';
                } else {
                    $.each(data, function (index, item) {
                        // Handle Status Badge logic
                        var isArchived = (item.IsArchived === true || item.IsArchived === "True" || item.IsArchived === "true");
                        var statusBadge = isArchived
                            ? '<span class="status-badge bg-danger text-white"><i class="fas fa-archive me-1"></i> Archived</span>'
                            : '<span class="status-badge bg-success text-white"><i class="fas fa-check-circle me-1"></i> Active</span>';

                        // Clean Null values
                        var name = item.StudentName || "-";
                        var roll = item.ClassRollNo || "-";
                        var dept = item.DepartmentName || "-";
                        var cls = item.ClassName || "-";
                        var session = item.SessionName || "-";
                        var section = item.SectionName || "-";
                        var batch = item.BatchName || "-";
                        var mobile = item.Mobile || "-";

                        // Build Row (Using modern Template Literals for cleaner code)
                        html += `<tr>
                            <td class="fw-bold text-dark">${name}</td>
                            <td>${roll}</td>
                            <td><span class="badge bg-light text-dark border px-2 py-1">${dept}</span></td>
                            <td>${cls}</td>
                            <td>${session}</td>
                            <td>${section}</td>
                            <td>${batch}</td>
                            <td><i class="fas fa-phone-alt text-muted small me-1"></i> ${mobile}</td>
                            <td>${statusBadge}</td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a href="/Student/Edit?id=${item.Id}" class="btn btn-light border btn-action text-primary shadow-sm" title="Edit Student">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <a href="/Student/Details?id=${item.Id}" class="btn btn-light border btn-action text-info shadow-sm" title="View Profile">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>`;
                    });
                }
                $('#pagedData').html(html);
            }

            function displayPagination(totalRecords, pageNumber, pageSize) {
                var totalPages = Math.ceil(totalRecords / pageSize);
                var paginationHtml = '<ul class="pagination mb-0">';

                // First & Previous buttons
                paginationHtml += `<li class="page-item ${pageNumber === 1 ? 'disabled' : ''}">
                                    <a class="page-link shadow-sm" href="#" data-page="1" title="First"><i class="fas fa-angle-double-left"></i></a>
                                   </li>`;
                paginationHtml += `<li class="page-item ${pageNumber === 1 ? 'disabled' : ''}">
                                    <a class="page-link shadow-sm" href="#" data-page="${pageNumber - 1}" title="Previous"><i class="fas fa-angle-left"></i></a>
                                   </li>`;

                // Page numbers
                var startPage = Math.max(1, pageNumber - 2);
                var endPage = Math.min(totalPages, startPage + 4);
                for (var i = startPage; i <= endPage; i++) {
                    paginationHtml += `<li class="page-item ${pageNumber === i ? 'active' : ''}">
                                        <a class="page-link shadow-sm" href="#" data-page="${i}">${i}</a>
                                       </li>`;
                }

                // Next & Last buttons
                paginationHtml += `<li class="page-item ${pageNumber === totalPages ? 'disabled' : ''}">
                                    <a class="page-link shadow-sm" href="#" data-page="${pageNumber + 1}" title="Next"><i class="fas fa-angle-right"></i></a>
                                   </li>`;
                paginationHtml += `<li class="page-item ${pageNumber === totalPages ? 'disabled' : ''}">
                                    <a class="page-link shadow-sm" href="#" data-page="${totalPages}" title="Last"><i class="fas fa-angle-double-right"></i></a>
                                   </li>`;

                paginationHtml += '</ul>';
                $('#pagingButtons').html(paginationHtml);
            }

            // Pagination click handler
            $(document).on('click', '.pagination a', function (e) {
                e.preventDefault();
                var newPage = $(this).data('page');
                if(newPage && newPage !== pageNumber) {
                    pageNumber = newPage;
                    $('#pagedData').html('<tr><td colspan="10" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i> Loading...</td></tr>');
                    fetchData(pageNumber, pageSize);
                }
            });
        });
    </script>
}