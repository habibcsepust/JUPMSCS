@model HallManagement.Model.ViewModels.RoomSeatEntryVm

@{
    ViewData["Title"] = "Room Allocation";
}

<style>
    /* Premium Allocation Form Styles */
    body {
        background-color: #f4f7f6;
    }

    .allocation-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        border: none;
        overflow: hidden;
        margin-bottom: 3rem;
    }

    .allocation-header {
        background: linear-gradient(135deg, #2b5876 0%, #4e4376 100%);
        padding: 30px 40px;
        color: white;
    }

    .panel-title {
        font-weight: 700;
        color: #4e4376;
        border-bottom: 2px solid #f0f7ff;
        padding-bottom: 12px;
        margin-bottom: 20px;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .modern-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        display: block;
    }

    .modern-select {
        border-radius: 10px;
        border: 1px solid #dee2e6;
        padding: 12px 15px;
        background-color: #f8f9fa;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .modern-select:focus {
            background-color: #fff;
            border-color: #4e4376;
            box-shadow: 0 0 0 4px rgba(78, 67, 118, 0.1);
        }

    /* History Table Styles */
    .history-container {
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        overflow: hidden;
        margin-top: 25px;
    }

    .history-header {
        padding: 12px 15px;
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
    }

        .history-header.room-history {
            background-color: #e8f4fd;
            color: #0056b3;
            border-bottom: 1px solid #b8daff;
        }

        .history-header.student-history {
            background-color: #fff3cd;
            color: #856404;
            border-bottom: 1px solid #ffeeba;
        }

    .table-history {
        margin-bottom: 0;
        font-size: 0.9rem;
    }

        .table-history th {
            background-color: #f8f9fa;
            color: #495057;
            font-weight: 600;
            border-bottom: 1px solid #dee2e6;
            padding: 10px 15px;
        }

        .table-history td {
            padding: 12px 15px;
            vertical-align: middle;
            color: #495057;
        }

    .action-buttons {
        background: #f8f9fa;
        padding: 20px 40px;
        border-top: 1px solid #e9ecef;
        display: flex;
        gap: 15px;
        align-items: center;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="allocation-card">

                <!-- Header -->
                <div class="allocation-header">
                    <h3 class="fw-bold mb-1"><i class="fas fa-bed me-2"></i> Student Room Allocation</h3>
                    <p class="text-white-50 mb-0">Assign a room/seat to a student and review their previous allocation history.</p>
                </div>

                <form asp-action="Create" method="post" id="myForm">
                    <div class="card-body p-4 p-md-5">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

                        <div class="row g-5">
                            <!-- Left Panel: Room/Seat Selection -->
                            <div class="col-md-6 border-end-md" style="border-color: #f0f7ff !important;">
                                <h5 class="panel-title"><i class="fas fa-door-open me-2 text-primary"></i> 1. Select Room/Seat</h5>

                                <div class="form-group mb-4">
                                    <label for="Id" class="modern-label">Target Room & Seat</label>
                                    <select asp-for="Id" class="form-select modern-select" asp-items="Model.RoomSeatsDdl">
                                        <option value="">-- Select an Available Seat --</option>
                                    </select>
                                    <span asp-validation-for="Id" class="text-danger small fw-bold mt-1 d-block"></span>
                                </div>

                                <!-- Room History Table -->
                                <div class="history-container shadow-sm">
                                    <h6 class="history-header room-history"><i class="fas fa-history me-2"></i> Previous Occupants (This Seat)</h6>
                                    <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                                        <table id="seathistoryDataGrid" class="table table-history table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Student Info</th>
                                                    <th>Updated By</th>
                                                    <th>Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr><td colspan="3" class="text-center text-muted py-4">Please select a seat to view history.</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Panel: Student Selection -->
                            <div class="col-md-6">
                                <h5 class="panel-title"><i class="fas fa-user-graduate me-2 text-warning"></i> 2. Select Student</h5>

                                <div class="form-group mb-4">
                                    <label for="StudentId" class="modern-label">Target Student</label>
                                    <select asp-for="StudentId" class="form-select modern-select" asp-items="Model.StudentsDdl">
                                        <option value="">-- Select a Student --</option>
                                    </select>
                                    <span asp-validation-for="StudentId" class="text-danger small fw-bold mt-1 d-block"></span>
                                </div>

                                <!-- Student History Table -->
                                <div class="history-container shadow-sm">
                                    <h6 class="history-header student-history"><i class="fas fa-history me-2"></i> Previous Allocations (This Student)</h6>
                                    <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                                        <table id="studenthistoryDataGrid" class="table table-history table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Room Info</th>
                                                    <th>Updated By</th>
                                                    <th>Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr><td colspan="3" class="text-center text-muted py-4">Please select a student to view history.</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons justify-content-end">
                        <a asp-action="Index" class="text-decoration-none fw-bold text-muted me-auto">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                        <button type="button" id="resetBtn" class="btn btn-light border text-danger fw-bold px-4" style="border-radius: 10px;">
                            <i class="fas fa-undo me-1"></i> Reset
                        </button>
                        <button type="submit" class="btn btn-success fw-bold px-4 shadow-sm" style="border-radius: 10px;">
                            <i class="fas fa-check-circle me-1"></i> Allocate Seat
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            // Clean Reset Functionality
            $('#resetBtn').on('click', function (event) {
                event.preventDefault();
                if(confirm('Are you sure you want to reset the form?')) {
                    $('#myForm')[0].reset();
                    $("#studenthistoryDataGrid tbody").html("<tr><td colspan='3' class='text-center text-muted py-4'>Please select a student to view history.</td></tr>");
                    $("#seathistoryDataGrid tbody").html("<tr><td colspan='3' class='text-center text-muted py-4'>Please select a seat to view history.</td></tr>");
                }
            });

            // ON PAGE LOAD
            var studentIdOnLoad = $("#StudentId").val();
            if (studentIdOnLoad) {
                loadStudentSeatHistory(studentIdOnLoad);
            }

            var seatIdOnLoad = $("#Id").val();
            if (seatIdOnLoad) {
                loadRoomSeatHistory(seatIdOnLoad);
            }

            // ON DROPDOWN CHANGE
            $("#StudentId").change(function () {
                var studentId = $(this).val();
                if (studentId) {
                    loadStudentSeatHistory(studentId);
                } else {
                    $("#studenthistoryDataGrid tbody").html("<tr><td colspan='3' class='text-center text-muted py-4'>Please select a student to view history.</td></tr>");
                }
            });

            $("#Id").change(function () {
                var seatId = $(this).val();
                if (seatId) {
                    loadRoomSeatHistory(seatId);
                } else {
                    $("#seathistoryDataGrid tbody").html("<tr><td colspan='3' class='text-center text-muted py-4'>Please select a seat to view history.</td></tr>");
                }
            });

            // AJAX FUNCTIONS
            function loadStudentSeatHistory(studentId) {
                $("#studenthistoryDataGrid tbody").html('<tr><td colspan="3" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i> Loading...</td></tr>');

                $.ajax({
                    url: "/RoomSeat/GetRoomSeatsByStudentId?studentId=" + studentId,
                    type: "GET",
                    success: function (response) {
                        var html = '';
                        if (response.data && response.data.length > 0) {
                            response.data.forEach(function (item) {
                                html += `<tr>
                                            <td class="fw-bold">${item.RoomInfo || '-'}</td>
                                            <td>${item.UpdatedBy || '-'}</td>
                                            <td><span class="badge bg-light text-dark border">${item.UpdateDate || '-'}</span></td>
                                         </tr>`;
                            });
                        } else {
                            html = `<tr><td colspan='3' class='text-center text-muted py-4'><i class="fas fa-info-circle me-1"></i> No previous room history found for this student.</td></tr>`;
                        }
                        $("#studenthistoryDataGrid tbody").html(html);
                    },
                    error: function () {
                        $("#studenthistoryDataGrid tbody").html("<tr><td colspan='3' class='text-center text-danger py-4'>Failed to load history data.</td></tr>");
                    }
                });
            }

            function loadRoomSeatHistory(seatId) {
                $("#seathistoryDataGrid tbody").html('<tr><td colspan="3" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i> Loading...</td></tr>');

                $.ajax({
                    url: "/RoomSeat/GetRoomSeatBySeatId?seatId=" + seatId,
                    type: "GET",
                    success: function (response) {
                        var html = '';
                        if (response.data && response.data.length > 0) {
                            response.data.forEach(function (item) {
                                html += `<tr>
                                            <td class="fw-bold">${item.StudentInfo || '-'}</td>
                                            <td>${item.UpdatedBy || '-'}</td>
                                            <td><span class="badge bg-light text-dark border">${item.UpdateDate || '-'}</span></td>
                                         </tr>`;
                            });
                        } else {
                            html = `<tr><td colspan='3' class='text-center text-muted py-4'><i class="fas fa-info-circle me-1"></i> No previous occupants found for this seat.</td></tr>`;
                        }
                        $("#seathistoryDataGrid tbody").html(html);
                    },
                    error: function () {
                        $("#seathistoryDataGrid tbody").html("<tr><td colspan='3' class='text-center text-danger py-4'>Failed to load history data.</td></tr>");
                    }
                });
            }
        });
    </script>
}