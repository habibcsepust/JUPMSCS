@model HallManagement.Model.Entities.Department

@{
    ViewData["Title"] = "Department Details";
}

<div class="container">
    <h4 class="pb-2 pt-2 border-bottom border-2 border-dark">Department Details</h4>
    <form class="form-horizontal">
        @*     @Html.ValidationSummary()*@
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="row">
            <div class="offset-md-2 col-md-6">
                <div class="form-group row">
                    <label asp-for="Name" class="col-md-5 col-form-label text-md-end fw-bold pt-4"></label>
                    <div class="col-md-7 pt-md-3">
                        <input asp-for="Name" disabled="disabled" class="form-control" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="offset-md-5 col-md-3 pt-3">
                        <a asp-action="Index">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
