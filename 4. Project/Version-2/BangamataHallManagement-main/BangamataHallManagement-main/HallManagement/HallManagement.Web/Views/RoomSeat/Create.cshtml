@model HallManagement.Model.ViewModels.RoomSeatEntryVm

@{
    ViewData["Title"] = "Room Allocation";
}

<div class="container">
    <h4>Student Room Allocation</h4>
    <hr />
    <form asp-action="Create" method="post" class="form-horizontal" id="myForm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger text-danger"></div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group row pt-2">
                    <label asp-for="Id" class="col-md-6 col-form-label text-md-end"></label>
                    <div class="col-md-5">
                        <select asp-for="Id" class="form-control form-select" asp-items="Model.RoomSeatsDdl">
                            <option value="">--Select--</option>
                        </select>
                        <span asp-validation-for="Id" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row pt-3 px-3">
                    <table id="seathistoryDataGrid" class="table table-striped table-bordered caption-top">
                        <caption class="bg-primary text-center text-white">Selected Room Previous Student:</caption>
                        <thead class="table-primary">
                            <tr>
                                <th>Student Info</th>
                                <th>Updated By</th>
                                <th>Update Date</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group row pt-2">
                    <label asp-for="StudentId" class="col-md-2 col-form-label text-md-end"></label>
                    <div class="col-md-5">
                        <select asp-for="StudentId" class="form-control form-select" asp-items="Model.StudentsDdl">
                            <option value="">--Select--</option>
                        </select>
                        <span asp-validation-for="StudentId" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row pt-3 px-3">
                    <table id="studenthistoryDataGrid" class="table table-striped table-bordered caption-top">
                        <caption class="bg-warning text-center text-white">Selected Student Previous Room:</caption>
                        <thead class="table-warning">
                            <tr>
                                <th>Room Info</th>
                                <th>Updated By</th>
                                <th>Update Date</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="offset-md-4 col-md-6">
                <div class="row">
                    <div class="col-sm-7 col-md-7">
                        <input type="submit" value="Submit" class="col-md-12 btn btn-success" />
                    </div>
                    @* <div class="col-sm-5 col-md-5">
                        <input type="reset" id="resetBtn" class="col-md-12 btn btn-danger" value="Reset" />
                    </div> *@
                    <div class="col-sm-5 col-md-5">
                        <a asp-action="Index" class="pt-2 link-primary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row pt-3">
        </div>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            /*RESET BUTTON START*/
            /* document.querySelector('#resetBtn').addEventListener('click', function (event) {
                //event.preventDefault();
                document.getElementById('myForm').reset();
                $("#studenthistoryDataGrid tbody").empty();
                $("#seathistoryDataGrid tbody").empty();
            });*/
            /*RESET BUTTON END*/

            /* ON PAGE LOAD START*/
            var selectedStudentIdOnLoad = $(this).find("option:selected");
            var studentIdOnLoad = selectedStudentIdOnLoad.val();
            $("#studenthistoryDataGrid tbody").empty();

            if (studentIdOnLoad) {
                loadStudentSeatHistory(studentIdOnLoad);
            }

            var selectedSeatIdOnLoad = $(this).find("option:selected");
            var seatIdOnLoad = selectedSeatIdOnLoad.val();
            $("#seathistoryDataGrid tbody").empty();

            if (seatIdOnLoad) {
                loadRoomSeatHistory(seatIdOnLoad);
            }
            /* ON PAGE LOAD END*/





            $("#StudentId").change(function () {
                var selectedStudentId = $(this).find("option:selected");
                var studentId = selectedStudentId.val();
                $("#studenthistoryDataGrid tbody").empty();

                if (studentId) {
                    loadStudentSeatHistory(studentId);
                }
            });

            $("#Id").change(function () {
                var selectedSeatId = $(this).find("option:selected");
                var seatId = selectedSeatId.val();
                $("#seathistoryDataGrid tbody").empty();

                if (seatId) {
                    loadRoomSeatHistory(seatId);
                }
            });

            function loadStudentSeatHistory(studentId) {
                var studentId = document.getElementById('StudentId').value;

                $.ajax({
                    url: "/RoomSeat/GetRoomSeatsByStudentId?studentId=" + studentId,
                    type: "GET",
                    success: function (seats) {
                        console.log(seats)
                        var tableBody = document.querySelector("#studenthistoryDataGrid tbody");
                        if (seats.data.length > 0) {
                            seats.data.forEach(function (item) {
                                var row = document.createElement("tr");
                                row.innerHTML = `
                                                <td>${item.RoomInfo}</td>
                                                <td>${item.UpdatedBy}</td>
                                                <td>${item.UpdateDate}</td>`;
                                tableBody.appendChild(row);
                            });
                        }
                        else {
                            var row = document.createElement("tr");
                            row.innerHTML = `<td colspan='3' class='text-center'> No data found.</td>`;
                            tableBody.appendChild(row);
                        }
                    },
                    error: function () {
                        alert("Error loading districts");
                    }
                });
            }

            function loadRoomSeatHistory(seatId) {
                $.ajax({
                    url: "/RoomSeat/GetRoomSeatBySeatId?seatId=" + seatId,
                    type: "GET",
                    success: function (seats) {
                        console.log(seats)
                        var tableBody = document.querySelector("#seathistoryDataGrid tbody");
                        if (seats.data.length > 0) {
                            seats.data.forEach(function (item) {
                                var row = document.createElement("tr");
                                row.innerHTML = `
                                                        <td>${item.StudentInfo}</td>
                                                        <td>${item.UpdatedBy}</td>
                                                        <td>${item.UpdateDate}</td>`;
                                tableBody.appendChild(row);
                            });
                        }
                        else {
                            var row = document.createElement("tr");
                            row.innerHTML = `<td colspan='3' class='text-center'> No data found.</td>`;
                            tableBody.appendChild(row);
                        }
                    },
                    error: function () {
                        alert("Error in asax calling.");
                    }
                });
            }
        });
    </script>
}
