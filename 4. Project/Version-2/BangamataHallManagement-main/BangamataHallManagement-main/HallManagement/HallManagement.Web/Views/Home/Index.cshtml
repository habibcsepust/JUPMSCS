@{
    ViewData["Title"] = "Home Page";
}

<style>
    /* Hero Carousel Styles */
    .carousel-item img {
        height: 70vh;
        object-fit: cover;
        filter: brightness(0.5); /* Makes text readable */
    }

    .carousel-caption {
        bottom: 30%;
        z-index: 10;
    }

        .carousel-caption h5 {
            font-size: 3.5rem;
            font-weight: 700;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.5);
        }

        .carousel-caption p {
            font-size: 1.2rem;
            font-weight: 300;
        }

    /* Modern Cards */
    .premium-card {
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border: none;
        transition: transform 0.3s ease;
    }

        .premium-card:hover {
            transform: translateY(-5px);
        }

    /* Section Titles */
    .section-title {
        font-weight: 700;
        color: #0a2540;
        position: relative;
        display: inline-block;
        margin-bottom: 2rem;
    }

        .section-title::after {
            content: "";
            position: absolute;
            width: 50%;
            height: 3px;
            background: #007bff;
            bottom: -10px;
            left: 25%;
            border-radius: 5px;
        }

    /* Custom Accordion */
    .accordion-button:not(.collapsed) {
        background-color: #f0f7ff;
        color: #0a2540;
        font-weight: 600;
    }

    .accordion-button:focus {
        box-shadow: none;
    }
</style>

<!-- Hero Slider -->
<div id="imageSlider" class="carousel slide carousel-fade" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/slider-images/1.jpg" class="d-block w-100" alt="Slide 1" />
            <div class="carousel-caption d-none d-md-block text-center">
                <h5>Welcome to University Hall Management System</h5>
                <p>Ensuring a secure and comfortable residential experience.</p>
            </div>
        </div>
        <!-- Add your other slider items here following the same structure -->
        <div class="carousel-item">
            <img src="~/images/slider-images/5.jpg" class="d-block w-100" alt="Slide 5" />
            <div class="carousel-caption d-none d-md-block">
                <h5>Modern Hall Management</h5>
                <p>Digitalizing administrative services for students.</p>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#imageSlider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#imageSlider" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!-- Welcome Message -->
<div class="container mt-n5 position-relative" style="z-index: 20;">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card premium-card p-4 text-center">
                <div class="card-body">
                    <h2 class="section-title">University Hall Management System</h2>
                    <p class="text-muted fs-5 mt-3 bengali-text">জাহাঙ্গীরনগর বিশ্ববিদ্যালয় এর আবাসিক হলসমূহের জন্য একটি স্বয়ংক্রিয় ও আধুনিক ডিজিটাল সমাধান।</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- About & Provost Section -->
<div class="container py-5 mt-5">
    <div class="row g-5 align-items-center">
        <!-- Profile Card -->
        <div class="col-md-5">
            <div class="premium-card p-4 text-center">
                <img src="~/images/professor_HK.jpg" class="img-fluid rounded-circle shadow border border-4 border-white mb-4" style="width: 200px; height: 200px; object-fit: cover;" alt="Prof. Dr. Abul Kalam Azad">
                <h4 class="fw-bold mb-1">Dr. Md. Humayun Kabir</h4>
                <p class="text-muted small mb-3">B.Sc (DU), MSc. (DU), PhD (Ireland)</p>
                <p class="badge bg-primary px-3 py-2 mb-4">Professor, CSE Department</p>
                <br>
                <a class="btn btn-outline-primary rounded-pill px-4" href="https://www.juniv.edu/teachers/hkabir" target="_blank">View Profile <i class="fas fa-arrow-right ms-2"></i></a>
            </div>
        </div>

        <!-- Details Section -->
        <div class="col-md-7">
            <div class="p-3">
                <h3 class="fw-bold text-dark mb-4 bengali-text">জাহাঙ্গীরনগর বিশ্ববিদ্যালয় হল ব্যবস্থাপনা</h3>
                <p class="text-muted bengali-text" style="text-align: justify; line-height: 1.8; font-size: 1.1rem;">
                    জাহাঙ্গীরনগর বিশ্ববিদ্যালয়ের হলসমূহ শিক্ষার্থীদের আবাসিক সুবিধা, নিরাপত্তা ও বিভিন্ন প্রশাসনিক সেবা প্রদানের গুরুত্বপূর্ণ প্রতিষ্ঠান। একটি হল ব্যবস্থাপনা ব্যবস্থার মাধ্যমে শিক্ষার্থীদের হলের আসন বরাদ্দ, আবাসিক তথ্য, রুম ব্যবস্থাপনা, শিক্ষার্থী তথ্য এবং অন্যান্য প্রয়োজনীয় কার্যক্রম সহজ ও সুশৃঙ্খলভাবে পরিচালনা করা যায়।
                </p>
                <div class="alert alert-info border-0 border-start border-4 border-primary mt-4 bengali-text" role="alert">
                    এই <strong>University Hall Management System</strong>-এর মূল উদ্দেশ্য হলো হলের প্রশাসনিক কার্যক্রমকে ডিজিটাল, দ্রুত, স্বচ্ছ ও কার্যকর করা এবং শিক্ষার্থী ও হল কর্তৃপক্ষের মধ্যে প্রয়োজনীয় তথ্য আদান-প্রদান সহজ করা।
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FAQ Section -->
<div class="container py-5 mb-5">
    <div class="text-center mb-5">
        <h3 class="section-title">Frequently Asked Questions</h3>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="accordion premium-card" id="faqAccordion">
                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            How to apply for a hall seat?
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Students can apply through the student panel after logging in with their university credentials. Ensure all your profile details are updated before applying.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingTwo">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                            How can I clear my establishment charges?
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Charges can be viewed in the 'Payments' module. You can generate a pay slip from the system and pay it to the designated bank branch.
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0">
                    <h2 class="accordion-header" id="headingThree">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                            What to do if I forget my password?
                        </button>
                    </h2>
                    <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Use the 'Forgot Password' link on the login page. An OTP or reset link will be sent to your registered email or phone number.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>