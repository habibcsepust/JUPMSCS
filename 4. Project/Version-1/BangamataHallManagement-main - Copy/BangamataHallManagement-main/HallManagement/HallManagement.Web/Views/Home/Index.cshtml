<div id="imageSlider" class="container-fluid carousel slide mt-0 pt-0 ps-0 pe-0" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/slider-images/1.jpg" class="d-block w-100" alt="Slide 1" />
            <div class="carousel-caption">
                <h5>Slide 1</h5>
                <p>This is the purpose or description of the image on Slide 1.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/slider-images/2.jpg" class="img-fluid d-block w-100" alt="Slide 2" />
            <div class="carousel-caption">
                <h5>Slide 2</h5>
                <p>This is the purpose or description of the image on Slide 2.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/slider-images/3.jpg" class="d-block w-100" alt="Slide 3" />
            <div class="carousel-caption">
                <h5>Slide 3</h5>
                <p>This is the purpose or description of the image on Slide 3.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/slider-images/4.jpg" class="d-block w-100" alt="Slide 4" />
            <div class="carousel-caption">
                <h5>Slide 4</h5>
                <p>This is the purpose or description of the image on Slide 4.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/slider-images/5.jpg" class="d-block w-100" alt="Slide 5" />
            <div class="carousel-caption">
                <h5>Slide 5</h5>
                <p>This is the purpose or description of the image on Slide 5.</p>
            </div>
        </div>
        <!-- Add more carousel items as needed -->
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#imageSlider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#imageSlider" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<div class="container-fluid section section-height-3 section-light-scale-1 border-0 pb-5 pt-5 bg-light">
    <div class="container">
        <div class="text-center">
            <div class="card shadow-lg for-not-scroll">
                <div class="card-header bg-info">
                    Welcome!!!
                </div>
                <div class="card-body">
                    <h5 class="card-title">University Hall Management System</h5>
                    <p class="card-text">    University Hall Management System, Jahangirnagar University</p>
                    @* <a href="#" class="btn btn-primary">Go somewhere</a>*@
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid section section-height-3 section-light-scale-1 border-0 pt-5 pb-5">
    <div class="container">
        <div class="row">
            <div class="col-md-6 ">
                <div class="shadow-lg for-not-scroll p-3" style="height: 100%; overflow: auto; max-height: 495px">
                        <div class="testimonial testimonial-style-2 mb-0 px-2">
                            <div class="testimonial-author text-center">
                                <img src="~/images/professor_HK.jpg" class="img-fluid rounded-circle" alt="Prof. Dr. Abul Kalam Azad">
                            </div>
                            <div class="home-about-edit  bg-warning">
                                <p style="text-align: justify; ">
                                    <font color="#282828" face="Average Sans, Arial, Helvetica, sans-serif">
                                        <span style="font-size: 15px;">
                                            Content coming soon...
                                            <br />
                                            <br />
                                            <br />
                                            <br />
                                        </span>
                                    </font>
                                </p>
                            </div>
                        <a class="btn btn-light text-uppercase text-primary text-color-hover-secondary text-1 py-2" href="https://www.juniv.edu/teachers/hkabir"><strong>VIEW MORE</strong><i class="fas fa-chevron-right text-2 pl-2"></i></a>
                            <div class="testimonial-author mt-2">
                            <p><strong class="font-weight-extra-bold text-2">- Dr. Md. Humayun Kabir, B.Sc(DU), MSc.(DU), PhD(Ireland) </strong><span>, Professor, Department of Computer Science and Engineering</span></p>
                            </div>
                        </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="shadow-lg for-not-scroll p-3" style="height: 100%; overflow: auto; max-height: 495px">
                    <h4 class="alert-heading pb-5">
                        জাহাঙ্গীরনগর বিশ্ববিদ্যালয় হল ব্যবস্থাপনা
                    </h4>
                    <p class="pb-5" style="text-align:justify">
                        জাহাঙ্গীরনগর বিশ্ববিদ্যালয়ের হলসমূহ শিক্ষার্থীদের আবাসিক সুবিধা, নিরাপত্তা ও বিভিন্ন প্রশাসনিক সেবা প্রদানের গুরুত্বপূর্ণ প্রতিষ্ঠান। একটি হল ব্যবস্থাপনা ব্যবস্থার মাধ্যমে শিক্ষার্থীদের হলের আসন বরাদ্দ, আবাসিক তথ্য, রুম ব্যবস্থাপনা, শিক্ষার্থী তথ্য এবং অন্যান্য প্রয়োজনীয় কার্যক্রম সহজ ও সুশৃঙ্খলভাবে পরিচালনা করা যায়। এই University Hall Management System-এর মূল উদ্দেশ্য হলো হলের প্রশাসনিক কার্যক্রমকে ডিজিটাল, দ্রুত, স্বচ্ছ ও কার্যকর করা এবং শিক্ষার্থী ও হল কর্তৃপক্ষের মধ্যে প্রয়োজনীয় তথ্য আদান-প্রদান সহজ করা।
                    </p>
                    <hr>
                    <p class="mb-0 text-bold">
                        -জাহাঙ্গীরনগর বিশ্ববিদ্যালয়ের হলসমূহে শিক্ষার্থীদের আবাসিক ও প্রশাসনিক কার্যক্রম সহজ, দ্রুত ও সুশৃঙ্খলভাবে পরিচালনার জন্য একটি আধুনিক ডিজিটাল Hall Management System।
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

